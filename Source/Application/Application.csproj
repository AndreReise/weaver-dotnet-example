<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Telemetry\" />
	</ItemGroup>

	<ItemGroup Label="Dependencies">
		<PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" Version="10.4.0" />
		<PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.1" />
	</ItemGroup>

	<PropertyGroup>
    <NoWarn Label="Gauge is experemental API">
      $(NoWarn);EXTEXP0003
    </NoWarn>
  </PropertyGroup>

</Project>