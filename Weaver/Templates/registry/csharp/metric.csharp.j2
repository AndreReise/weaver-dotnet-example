{%- macro to_pascal_case(value) -%}
	{%- set parts = value | replace('.', '_') | split('_') -%}
	{%- for p in parts -%}{{ p | capitalize }}{%- endfor -%}
{% endmacro %}
{%- macro to_snake_case(name) -%}
{%- set result = "" -%}
{%- for c in name -%}
	{%- if c.isupper() -%}
		{%- if loop.index > 1 -%}_{%- endif -%}{{ c.lower() }}
	{%- else -%}
		{{ c }}
	{%- endif -%}
{%- endfor -%}
{{ result }}
{%- endmacro -%}

{%- macro to_snake_case(value) -%}
{{ value | replace('.', '_') | replace('-', '_') | lower -}}
{%- endmacro -%}

{%- set tag_name_attribute = "global::Microsoft.Extensions.Diagnostics.Metrics.TagName" -%}
// <auto-generated/>
namespace {{ params.service_namespace}};

using System.Diagnostics.Metrics;

public static partial class Metrics
{
{%- for metric in ctx %}
	{%- if metric.attributes | default([]) | length > 0 %}
	public struct {{to_pascal_case(metric.id)}}Tags
	{
		{%- for item in metric.attributes %}
			{%- if item.type.members is defined %}
				{%- set type = to_pascal_case(item.name) %}
			{%- else %}
				{%- set type = item.type %}
			{%- endif %}
		
		[{{ tag_name_attribute }}("{{ to_snake_case(item.name) }}")]
		public{% if item.requirement_level == "required" %} required{% endif %} {{ type }} {{ to_pascal_case(item.name) }} { get; set; }

		{%- endfor %}
	}

	{# Extra blank line after struct #}
	{%- endif %}

{%- set instrument_map = {
	"counter": "global::Microsoft.Extensions.Diagnostics.Metrics.Counter",
	"gauge": "global::Microsoft.Extensions.Diagnostics.Metrics.Gauge",
	"histogram": "global::Microsoft.Extensions.Diagnostics.Metrics.Histogram",
	"updowncounter": "global::Microsoft.Extensions.Diagnostics.Metrics.Gauge"
} %}

{%- set metric_name = to_snake_case(metric.metric_name) %}
{%- set metric_type = instrument_map.get(metric.instrument) %}

	{%- if metric.attributes | default([]) | length > 0 %}
	[{{ metric_type }}<double>(typeof({{ to_pascal_case(metric.id) }}Tags), Name = "{{ metric_name }}")]
	{%- else %}
	[{{ metric_type }}<double>(Name = "{{ metric_name }}")]
	{%- endif %}
	public static partial {{ to_pascal_case(metric.id) + "Metric" }} {{ "Create" + to_pascal_case(metric.id) }}(Meter meter);

	{# Blank line after method for separation #}
{%- endfor %}
}
