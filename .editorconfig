root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 300
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace: true

[*.{js,json,props,csproj,xml}]
indent_size = 2
tab_width = 2

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml, yaml}]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
